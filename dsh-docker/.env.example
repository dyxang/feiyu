# 复制为 .env 后按需修改。.env 不进 git（已在 .gitignore）

# 镜像：GitHub Actions 构建后自动推送，改成 你的GitHub用户名/dsh-harness
DSH_IMAGE=ghcr.io/your-name/dsh-harness:latest

# Caddy basic auth 凭据（bcrypt hash），生成方式：
#   docker run --rm -it caddy:2 caddy hash-password
# 也可以直接给明文 BASIC_AUTH_PASSWORD（启动时自动 hash；注意 .env 文件权限）
CADDY_HASH=
# BASIC_AUTH_PASSWORD=

# Tailscale auth key：https://login.tailscale.com/admin/settings/keys
# 建议选 reusable、不选 ephemeral；key 只留在 NAS 上，不进镜像不进 git
TAILSCALE_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# 数据目录（按 NAS 共享文件夹实际路径调整，建议指向持久化存储）
TS_STATE_PATH=./tailscale-state
DSH_WORKSPACE_PATH=./workspace
DSH_HOME_PATH=./dsh-home
